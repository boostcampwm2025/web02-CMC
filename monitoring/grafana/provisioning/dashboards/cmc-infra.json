{
  "title": "CMC Infra",
  "uid": "cmc-infra",
  "tags": ["cmc", "infra", "cadvisor"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "container_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(container_cpu_usage_seconds_total{job=\"cadvisor\"}, id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus Scrape Targets (up)",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "targets": [
        {
          "expr": "sum(up{job=~\"backend|cadvisor\"})",
          "legendFormat": "up targets"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Usage (cores) by container",
      "datasource": "Prometheus",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "cores" } },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor\", id=~\"$container_id\"}[1m])) by (id, name, container_label_com_docker_compose_service)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory Working Set by container",
      "datasource": "Prometheus",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{job=\"cadvisor\", id=~\"$container_id\"}) by (id, name, container_label_com_docker_compose_service)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network RX/TX by container",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{job=\"cadvisor\", id=~\"$container_id\"}[1m])) by (id, name, container_label_com_docker_compose_service)",
          "legendFormat": "{{name}}"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{job=\"cadvisor\", id=~\"$container_id\"}[1m])) by (id, name, container_label_com_docker_compose_service)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Filesystem Usage by container",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum(container_fs_usage_bytes{job=\"cadvisor\", id=~\"$container_id\"}) by (id, name, container_label_com_docker_compose_service)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Top DB/Cache Container Candidates",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{job=\"cadvisor\", id=~\".*(redis|postgres|backend|frontend).*\"}) by (id, name, container_label_com_docker_compose_service)",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
